{
  "manifest_version": 3,
  "name": "网页浏览时长统计",
  "version": "2.2.0",
  "description": "统计用户在浏览器中访问不同网站的实际停留时长，并提供日、周、月报表、场景模式与专注管理能力。",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "notifications",
    "idle"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.svg",
      "48": "images/icon48.svg",
      "128": "images/icon128.svg"
    }
  },
  "icons": {
    "16": "images/icon16.svg",
    "48": "images/icon48.svg",
    "128": "images/icon128.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
